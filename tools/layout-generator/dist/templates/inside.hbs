<div class="ubs-inside">
  {{!-- Header area --}}
  <header class="ubs-inside__header">
    <div class="ubs-inside__header-left">
      <span class="ubs-inside__section-title"><!-- Section Title --></span>
    </div>
    <div class="ubs-inside__header-right">
      <span class="ubs-inside__document-title"><!-- Document Title --></span>
    </div>
  </header>

  {{!-- Impulse line --}}
  {{#if options.impulse}}
  <div class="ubs-impulse" aria-hidden="true"></div>
  {{/if}}

  {{!-- Main body content --}}
  <main class="ubs-inside__body">
    {{!-- Image area (if applicable) --}}
    {{#unless (eq options.imageLayout "no-image")}}
    <div class="ubs-inside__image ubs-image-layout--{{options.imageLayout}}">
      <div class="ubs-inside__image-placeholder">
        <!-- Replace with content imagery -->
      </div>
    </div>
    {{/unless}}

    {{!-- Text content area --}}
    <div class="ubs-inside__content">
      <h2 class="ubs-heading ubs-heading--2"><!-- Section Heading --></h2>
      <div class="ubs-body-text">
        <!-- Body content -->
      </div>
    </div>
  </main>

  {{!-- Footer area --}}
  <footer class="ubs-inside__footer">
    <div class="ubs-inside__footer-left">
      <span class="ubs-inside__disclaimer"><!-- Legal disclaimer --></span>
    </div>
    <div class="ubs-inside__footer-right">
      <span class="ubs-inside__page-number"><!-- Page number --></span>
    </div>
  </footer>

  {{!-- Logo tab (bottom-right) --}}
  <div class="ubs-logo-tab">
    <div class="ubs-logo" role="img" aria-label="UBS">
      <svg class="ubs-logo__svg" viewBox="0 0 100 32" xmlns="http://www.w3.org/2000/svg">
        <rect width="100" height="32" fill="none" stroke="currentColor" stroke-width="1"/>
        <text x="50" y="22" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="currentColor">UBS</text>
      </svg>
    </div>
  </div>
</div>
